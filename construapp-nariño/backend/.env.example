# Backend Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database
# DB_DIALECT: "postgres" (por defecto) o "sqlite" (sin infraestructura, para dev rápido)
DB_DIALECT=postgres
DB_HOST=localhost
# Puerto 5433: el docker-compose expone Postgres en 5433 para no chocar con un
# PostgreSQL local en 5432. Si usas un Postgres propio en 5432, cambia a 5432.
DB_PORT=5433
DB_NAME=construapp_narino
DB_USER=construapp_user
DB_PASSWORD=construapp_password
# DB_STORAGE=./data/construapp.sqlite   # solo si DB_DIALECT=sqlite
# DB_LOGGING=true                        # imprime cada consulta SQL

# Redis (docker-compose lo expone en 6380 en el host)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT (obligatorio en producción)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE_DAYS=30

# Admin inicial (opcional): `npm run seed` crea/promueve esta cuenta si ambas están
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Recuperación de contraseña. Sin SMTP configurado (SMTP_*), el enlace se
# escribe en el log del backend en vez de enviarse por correo.
PASSWORD_RESET_EXPIRE_MINUTES=30

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@construappnarino.com

# Third Party APIs
WEATHER_API_KEY=your_weather_api_key
LOCATION_API_KEY=your_location_api_key

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# CORS Settings
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Rate Limiting (global)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
# Rate limit estricto para /auth/login y /auth/register (por IP)
AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_DISABLED=true   # desactívalo solo en tests locales

# Sitio Web
FRONTEND_URL=http://localhost:3000
MOBILE_URL=exp://localhost:8081
